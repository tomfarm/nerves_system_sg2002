Fix OpenSBI build with GCC 14

Replace fence.i instructions with raw encoding (.insn 0x100f) since
GCC 14 requires the zifencei extension to be explicitly specified.
Also initialize cnt variable to fix -Werror warning.

--- a/include/sbi/riscv_barrier.h
+++ include/sbi/riscv_barrier.h
@@ -19,7 +19,7 @@
 	__asm__ __volatile__ ("fence " #p "," #s : : : "memory")
 
 #define RISCV_FENCE_I \
-	__asm__ __volatile__ ("fence.i" : : : "memory")
+	__asm__ __volatile__ (".insn 0x100f" : : : "memory")
 
 /* Read & Write Memory barrier */
 #define mb()			RISCV_FENCE(iorw,iorw)
